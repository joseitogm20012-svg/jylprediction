# Copia este archivo a .env y rellena los valores.
# En Render estas variables se configuran en el dashboard del servicio.

# Servidor
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Auth (obligatorio para login/registro)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Panel de administración (/admin.html)
ADMIN_PASSWORD=

# Postgres de producción. Vacío = usa SQLite local (backend/data/user_data.db)
DATABASE_URL=

# API externa de fútbol (opcional)
API_FOOTBALL_KEY=

# --- MongoDB (módulo de gestión MVC) ---
MONGODB_URI=
MONGODB_DB=jly_predictor
